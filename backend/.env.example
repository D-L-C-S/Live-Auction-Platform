PORT=5000
MONGO_URI=mongodb://localhost:27017/live_auction
JWT_SECRET=your_jwt_secret_here
CLIENT_URL=http://localhost:5173
PROXY_BID_INCREMENT=1

# For multiple frontend origins, use comma-separated values:
# CLIENT_URL=http://localhost:5173,https://your-frontend.up.railway.app

# Stripe - get keys from https://dashboard.stripe.com/apikeys (use test keys for dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook secret - needed for Stripe webhook verification
STRIPE_WEBHOOK_SECRET=whsec_...
